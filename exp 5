#include <iostream>
using namespace std;

class Shape
{
public:

    void area(int side)
    {
        cout << "Area of Square = " << side * side << endl;
    }

    void area(int length, int width)
    {
        cout << "Area of Rectangle = " << length * width << endl;
    }

    void area(float radius)
    {
        cout << "Area of Circle = " << 3.14 * radius * radius << endl;
    }
};

int main()
{
    Shape s;

    s.area(5);          // Square
    s.area(10, 5);      // Rectangle
    s.area(7.0f);       // Circle

    return 0;
}
