#include <iostream>
using namespace std;

class Rectangle
{
    float length, width;

public:

    void getData()
    {
        cout << "Enter length: ";
        cin >> length;

        cout << "Enter width: ";
        cin >> width;
    }

    void area()
    {
        cout << "Area of rectangle = " << length * width << endl;
    }

    void perimeter()
    {
        cout << "Perimeter of rectangle = "
             << 2 * (length + width) << endl;
    }
};

int main()
{
    Rectangle r;

    r.getData();
    r.area();
    r.perimeter();

    return 0;
}
